# Core backend configuration (required)
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rolematch
PORT=5000
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:5000
# Comma-separated. In production, include the published chrome-extension:// ID.
CORS_ORIGINS=http://localhost:5173

# Generate both secrets with: npm run setup:env
JWT_SECRET=
APP_ENCRYPTION_KEY=

# Gmail connection (optional). One deployed backend configuration serves all users.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Live job providers (optional; ATS board adapters do not require these keys)
SERPAPI_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=

# Local-only convenience account. Keep disabled in shared or production deployments.
SEED_DEMO_USER=false
DEMO_USER_EMAIL=admin@rolematch.com
DEMO_USER_PASSWORD=
